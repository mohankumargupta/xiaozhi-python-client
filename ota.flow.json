    {
        "id": "6a0014398ef5a313",
        "type": "function",
        "z": "deaf1bea418eb951",
        "name": "function 2",
        "func": "function generate_serial_number(mac) {\n    // 1. Clean the MAC address\n    const macClean = mac.replace(/:/g, \"\");\n\n    // 2. Generate MD5 hash and take first 8 characters\n    const shortHash = crypto\n        .createHash('md5')\n        .update(macClean)\n        .digest('hex')\n        .substring(0, 8)\n        .toUpperCase();\n\n    // 3. Return the formatted string\n    return `SN-${shortHash}-${macClean}`;\n}\n\nconst mac = flow.get('mac');\nconst serial_number = generate_serial_number(mac);\nconst ota = flow.get('ota');\nconst code = ota.activation.code;\nconst challenge = ota.activation.challenge;\nconst now = Math.floor(Date.now() / 1000);\nconst hmac_message = `xiaozhi-activation-${now}`;\n\n\nconst hash = crypto.createHash('sha256')\n    .update(hmac_message)\n    .digest('hex');\n\nconst { v4: uuidv4 } = uuid; \nconst device_id = mac;\nconst client_id = uuidv4();\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Activation-Version': '2',\n    'Device-Id': device_id,\n    'Client-Id': client_id,   \n};\n/* \n\n    \"code\": code,\n    \"challenge\": challenge,\n    \"now\": now,\n    \"hash\": hash,\n*/\nmsg.payload = {\n    \"Payload\": {\n        \"algorithm\": \"hmac-sha256\",\n        \"challenge\": challenge,\n        \"hmac\": hash,\n        \"serial_number\": serial_number,\n    },\n};\nmsg.requestTimeout = 3000;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
